{
  "name": "dockermanager",
  "version": "0.1.0",
  "private": true,
  "description": "A resilient Docker Compose manager with snapshot-first architecture",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @dockermanager/shared && npm run build -w @dockermanager/server && npm run build -w @dockermanager/web",
    "typecheck": "tsc -p packages/web/tsconfig.json --pretty false",
    "dev:server": "npm run dev -w @dockermanager/server",
    "dev:web": "npm run dev -w @dockermanager/web",
    "test": "vitest run",
    "clean": "rimraf packages/*/dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
